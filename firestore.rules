rules_version = '2';

// Security rules for JagaDosis (project: jagadosis-cfc6e).
//
// Principle: every document under `users/{uid}` is private to the account whose
// uid matches the document id. A signed-in user can read and write only their
// own profile; no one can touch another user's data, and signed-out requests
// are rejected outright.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Future medicine/history sub-collections inherit the same owner-only
      // access (Phase 2). Remove if you model those as top-level collections.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
